# Copie para .env e preencha. O .env não vai para o Git.

# Banco. Sem DATABASE_URL, a API usa o SQLite local (banco.db).
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# DATABASE_SSL=true

# Porta do servidor (padrão 3000)
# PORT=3000

# Chave que assina os JWT de login. Obrigatória em produção: sem ela, todo mundo
# é deslogado a cada reinício. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Endereço público do front-end. Em produção: https://write-w.vercel.app
# Define para onde o login com Google volta e liga o cookie "Secure" (https).
APP_URL=http://localhost:5173

# Login com Google (opcional). Sem isso, o botão "Continuar com Google" não aparece.
# Crie em https://console.cloud.google.com → APIs e serviços → Credenciais → ID do cliente OAuth
# URI de redirecionamento autorizado: <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
